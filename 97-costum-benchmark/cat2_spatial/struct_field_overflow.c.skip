/*
 * TEST: struct_field_overflow
 * CATEGORY: cat7_spatial_variants
 * PURPOSE: 结构体字段溢出 — 写入超过字段边界的值，但不出 struct 整体范围
 *
 * RSan:   MISS — struct 整体在一个 slot 中，字段溢出不超出对象 bound
 * MixSan: MISS — 同对象内 MemTag 相同，Stage 2 也不触发
 *
 * RATIONALE:
 *   这是**已知局限**测试 — 两种 sanitizer 都无法检测 intra-object overflow。
 *   放入测试套件中作为文档，表明已注意到此局限。
 *   检测此类 bug 需要 sub-object 级别的元数据粒度。
 */
#include <stdlib.h>
#include <stdio.h>
#include <string.h>

struct widget {
    char  name[8];
    int   flags;
    char  payload[16];
    void *callback;
};

int main(void) {
    struct widget *w = (struct widget*)calloc(1, sizeof(struct widget));
    if (!w) return 1;

    // 溢出 name 字段，覆盖 flags，但不超出 widget 整体 bound
    strcpy(w->name, "OVERFLOW!!!");  // 11 chars + null = 12 bytes > 8
    printf("name=%s flags=0x%x\n", w->name, w->flags);

    // 继续使用被破坏的 flags
    if (w->flags == 0x21212121) {
        printf("intra-object overflow NOT detected (known limitation)\n");
    }

    free(w);
    return 0;
}
