/*
 * TEST: {{test_name}}
 * CATEGORY: gen_df_reuse
 * PURPOSE: quarantine驱逐后, slot经历{{n_cycles}}轮复用再double-free
 *
 * RSan:   {{expect_rsan}}
 * MixSan: {{expect_mixsan}} ({{prob}})
 */
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

int main(void) {
    char *p = (char*)malloc({{alloc_size}});
    if (!p) return 1;
    p[0] = 'P';
    free(p);

    // exhaust quarantine ({{chunk_mb}}MB×{{n_chunks}}={{total_mb}}MB declared, tcmalloc rounds 32MB→64MB so 512MB actual > 256MB quarantine)
    for (int i = 0; i < {{n_chunks}}; i++) {
        volatile char *tmp = (char*)malloc({{chunk_size}});
        if (tmp) { tmp[0] = (char)i; free((void*)tmp); }
    }

    // {{n_cycles}} rounds of malloc (hold, don't free) to consume free slots
    char *held[{{n_cycles}}];
    for (int i = 0; i < {{n_cycles}}; i++) {
        held[i] = (char*)malloc({{alloc_size}});
        if (held[i]) held[i][0] = (char)i;
    }

    // last alloc to occupy p's evicted slot
    char *latest = (char*)malloc({{alloc_size}});
    if (!latest) return 1;
    latest[0] = 'L';

    // Double-free — slot is occupied, RSan *meta_ptr≠0 → MISS
    free(p);
    // Use _exit to avoid cleanup-time trap from atexit/dtors
    _exit(0);
}
