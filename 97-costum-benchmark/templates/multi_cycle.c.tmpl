/*
 * TEST: {{test_name}}
 * CATEGORY: gen_multi_cycle
 * PURPOSE: quarantine驱逐后, slot经历{{n_cycles}}轮复用再UAF
 *
 * RSan:   MISS — victim已被驱逐, slot被latest占用, spatial check通过
 * MixSan: {{expect_mixsan}} ({{prob}})
 */
#include <stdlib.h>
#include <stdio.h>
#include <string.h>

int main(void) {
    char *victim = (char*)malloc({{alloc_size}});
    if (!victim) return 1;
    victim[0] = 'V';
    free(victim);

    // exhaust quarantine: {{chunk_mb}}MB × {{n_chunks}} = {{total_mb}}MB > 256MB
    for (int i = 0; i < {{n_chunks}}; i++) {
        volatile char *tmp = (char*)malloc({{chunk_size}});
        if (tmp) { tmp[0] = (char)i; free((void*)tmp); }
    }

    // {{n_cycles}} rounds of malloc (hold, don't free) to consume all same-size free slots
    // This forces later mallocs to reuse victim's evicted slot
    char *held[{{n_cycles}}];
    for (int i = 0; i < {{n_cycles}}; i++) {
        held[i] = (char*)malloc({{alloc_size}});
        if (held[i]) held[i][0] = (char)i;
    }

    char *latest = (char*)malloc({{alloc_size}});
    if (!latest) return 1;
    latest[0] = 'L';

    // UAF — RSan: slot occupied by latest, spatial check passes → MISS
    volatile char c = victim[0];
    printf("victim[0]=%02x after exhaustion + %d cycles\n", (unsigned char)c, {{n_cycles}});

    free(latest);
    for (int i = 0; i < {{n_cycles}}; i++) free(held[i]);
    return 0;
}
