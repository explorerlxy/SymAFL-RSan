/*
 * TEST: {{test_name}}
 * CATEGORY: gen_realloc_chain
 * PURPOSE: {{chain_len}}-step realloc chain — UAF via intermediate pointer #{{dangle_idx}}
 *
 * RSan:   {{expect_rsan}}
 * MixSan: {{expect_mixsan}}
 */
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>

int main(void) {
    char *ptrs[{{chain_len}}];
    ptrs[0] = (char*)malloc({{init_size}});
    if (!ptrs[0]) return 1;
    memset(ptrs[0], 0x11, {{init_size}});

    // Each realloc adds {{step_size}} bytes — large enough to force buffer move
    for (int i = 1; i < {{chain_len}}; i++) {
        ptrs[i] = (char*)realloc(ptrs[i-1], {{init_size}} + i * {{step_size}});
        if (!ptrs[i]) return 1;
        memset(ptrs[i], (char)i, 256);
    }

    // exhaust quarantine — evicts old slots freed by realloc moves
    for (int i = 0; i < 8; i++) {
        volatile char *tmp = (char*)malloc(32 * 1024 * 1024);
        if (tmp) { tmp[0] = (char)i; free((void*)tmp); }
    }

    // pre-allocate at same size as the evicted slot to occupy it
    size_t dangle_sz = {{init_size}} + {{dangle_idx}} * {{step_size}};
    char *dummy = (char*)malloc(dangle_sz);

    // UAF via intermediate (dangling) pointer
    volatile char c = ptrs[{{dangle_idx}}][0];
    printf("ptrs[%d][0]=%02x\n", {{dangle_idx}}, (unsigned char)c);

    _exit(0);
}
