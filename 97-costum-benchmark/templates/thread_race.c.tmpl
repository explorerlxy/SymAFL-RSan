#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <pthread.h>
#include <unistd.h>

static char *shared = NULL;
static volatile int ready = 0;

void *access_thread(void *arg) {
    (void)arg;
    while (!ready) { }
    {{thread_action}}
    return NULL;
}

int main(void) {
    shared = (char*)malloc({{alloc_size}});
    if (!shared) return 1;
    memset(shared, 0xAB, {{alloc_size}} > 256 ? 256 : {{alloc_size}});

    pthread_t threads[{{n_threads}}];
    {{thread_create_loop}}

    // main_action: free shared + exhaust quarantine
    {{main_action}}

    // exhaust quarantine: {{chunk_mb}}MB × {{n_chunks}}
    for (int i = 0; i < {{n_chunks}}; i++) {
        volatile char *t = (char*)malloc({{chunk_size}});
        if (t) { t[0] = (char)i; free((void*)t); }
    }

    // occupy the evicted slot before threads access it
    char *dummy = (char*)malloc({{alloc_size}});
    dummy[0] = 'D';

    ready = 1;
    for (int i = 0; i < {{n_threads}}; i++) {
        pthread_join(threads[i], NULL);
    }
    _exit(0);
}
