#include <stdlib.h>
#include <stdio.h>
#include <string.h>

int main(void) {
    char *victim = (char*)malloc({{victim_size}});
    if (!victim) return 1;
    memset(victim, 0xAB, {{victim_size}} > 256 ? 256 : {{victim_size}});
    printf("victim=%p\n", (void*)victim);
    free(victim);

    // exhaust quarantine: {{chunk_mb}}MB × {{n_chunks}}
    for (int i = 0; i < {{n_chunks}}; i++) {
        volatile char *tmp = (char*)malloc({{chunk_size}});
        if (tmp) { tmp[0] = (char)i; free((void*)tmp); }
    }

    char *reuser = (char*)malloc({{victim_size}});
    if (!reuser) return 1;
    reuser[0] = 'R';
    printf("reuser=%p\n", (void*)reuser);

    // UAF
    volatile char c = victim[0];
    printf("victim[0]=%02x\n", (unsigned char)c);

    free(reuser);
    return 0;
}
